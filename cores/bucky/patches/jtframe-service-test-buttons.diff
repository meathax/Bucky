@@ -102,11 +102,18 @@ wire [ 9:0] lock_joy1;
 // This one passes unfiltered
 assign  game_paddle_2 = board_paddle_2;
 
-localparam START_BIT  = 6+(BUTTONS-2);
-localparam COIN_BIT   = START_BIT+1;
-localparam PAUSE_BIT  = COIN_BIT+1;
-
-reg        joy_pause=0, joy_test=0;
+localparam START_BIT   = 6+(BUTTONS-2);
+localparam COIN_BIT    = START_BIT+1;
+localparam PAUSE_BIT   = COIN_BIT+1;
+// SERVICE_BIT/TEST_BIT: two more MRA-mappable buttons beyond the fixed Start/Coin/Pause
+// trio above. Free real estate on the 16-bit board_joy* word (nothing else in this
+// framework reads bits 10/11) - no core needs its own port width change, since these
+// feed the already-existing dedicated game_service/game_test signals, not the
+// per-game joystick1..4 bus (which stays capped at BUTTONS+3 bits, untouched here).
+localparam SERVICE_BIT = PAUSE_BIT+1;
+localparam TEST_BIT    = SERVICE_BIT+1;
+
+reg        joy_pause=0, joy_test=0, joy_service=0;
 wire [3:0] joy_start, joy_coin;
 
 `ifdef POCKET   // The Pocket only uses the small buttons at the front for these functions
@@ -118,7 +125,13 @@ wire [3:0] joy_start, joy_coin;
     assign joy_coin  = 0;
 `else
     always @(posedge clk) begin
-        joy_pause <= board_joy1[PAUSE_BIT] | board_joy2[PAUSE_BIT] | board_joy3[PAUSE_BIT] | board_joy4[PAUSE_BIT];
+        joy_pause   <= board_joy1[PAUSE_BIT]   | board_joy2[PAUSE_BIT]   | board_joy3[PAUSE_BIT]   | board_joy4[PAUSE_BIT];
+        // Momentary Service-credit and cabinet Test-mode buttons, MRA-mappable exactly
+        // like Start/Coin/Pause above (same board_joy* word, next two free bit slots).
+        // Added for Bucky O'Hare (moo.cpp/GX173 real hardware has physical SERVICE and
+        // TEST buttons); shared across all jtcores since jtframe_joysticks is common.
+        joy_service <= board_joy1[SERVICE_BIT] | board_joy2[SERVICE_BIT] | board_joy3[SERVICE_BIT] | board_joy4[SERVICE_BIT];
+        joy_test    <= board_joy1[TEST_BIT]    | board_joy2[TEST_BIT]    | board_joy3[TEST_BIT]    | board_joy4[TEST_BIT];
     end
     assign joy_start = { board_joy4[START_BIT], board_joy3[START_BIT], board_joy2[START_BIT], board_joy1[START_BIT]};
     assign joy_coin  = { board_joy4[COIN_BIT] , board_joy3[COIN_BIT] , board_joy2[COIN_BIT] , board_joy1[COIN_BIT]};
@@ -155,6 +168,7 @@ jtframe_joysticks u_joysticks(
     .joy_test   ( joy_test      ),
     .key_test   ( key_test      ),
     .key_tilt   ( key_tilt      ),
+    .joy_service( joy_service   ),
 
     .mouse_but_1p( mouse_but_1p ),
     .mouse_but_2p( mouse_but_2p ),
